{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "final",
  "compatibility_date": "2026-07-30",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "www.desorden.cat/*",
      "zone_name": "desorden.cat"
    }
  ],
  "assets": {
    "directory": "./public/",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
